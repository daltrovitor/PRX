# PRX: variáveis de ambiente. Copie para .env.local (desenvolvimento) ou cadastre na Vercel (produção).
# Linhas com "#" são opcionais: o valor mostrado é só um exemplo. Depois de mudar variáveis na Vercel, faça um novo deploy
# (as NEXT_PUBLIC_* entram no build).

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Só no servidor: nunca em variável NEXT_PUBLIC_*. Sem ela, o app roda em memória (somente desenvolvimento).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Endereços e sessão -------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Em produção (docs/DOMINIOS.md): o app fica em teste.prx.app.br; os links entre painéis, os e-mails e os metadados partem daqui.
# NEXT_PUBLIC_SITE_URL=https://teste.prx.app.br
# Hosts extras que mostram a página de teaser, separados por vírgula.
# PRX_TEASER_HOSTS=
# Segredo da sessão (32+ caracteres aleatórios). Em produção, sem ele o app deriva do SUPABASE_SERVICE_ROLE_KEY;
# sem os dois, falha ao assinar sessões.
JWT_SECRET_OR_HMAC_KEY=your_jwt_hmac_secret

# --- Login com o Google -------------------------------------------------------
# Login no endereço do PRX (docs/LOGIN_GOOGLE.md). Sem as duas variáveis, o app usa o login do Supabase.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Acesso e contas de teste -------------------------------------------------
# E-mails com acesso de administrador, separados por vírgula. Substitui a lista padrão de lib/admin-allowlist.ts.
# PRX_ADMIN_EMAILS=
# Fora da produção as contas de demonstração existem; "true" as desliga.
# PRX_DISABLE_DEMO_ACCOUNTS=true
# Segredo próprio do QR dinâmico do PRX PASS. Sem ele, deriva do segredo da sessão.
# PRX_PASS_QR_SECRET=
# Biometria (WebAuthn): por padrão usa o domínio da requisição. Fixe só atrás de proxy.
# PRX_WEBAUTHN_RP_ID=
# PRX_WEBAUTHN_ORIGINS=

# --- Notificações (docs/NOTIFICACOES.md) --------------------------------------
# Sem as chaves, o desenvolvimento simula o envio.
RESEND_API_KEY=
PRX_EMAIL_FROM=PRX <noreply@prx.app.br>
PRX_EMAIL_REPLY_TO=suporte@prx.app.br
NEXT_PUBLIC_PRX_SUPPORT_EMAIL=suporte@prx.app.br
# Base das imagens dos e-mails. Sem isso, usa o endereço público do site.
# PRX_EMAIL_ASSETS_URL=
# Link da Resenha (docs/RESENHA.md): sem isso, sai em https://prx.app.br (em desenvolvimento, no próprio localhost).
# RESENHA_PUBLIC_URL=https://prx.app.br
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=prx_codigo_verificacao
# WHATSAPP_TEMPLATE_LANG=pt_BR
# WHATSAPP_API_VERSION=v23.0

# --- Notificações no celular (push) -------------------------------------------
# Gere o par com: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:suporte@prx.app.br

# --- PRX BANK e pagamentos ----------------------------------------------------
# Nenhum banco parceiro nem provedor de pagamentos está ligado hoje (docs/BANCO_PROVEDOR.md).
# production: desliga o sandbox e só aceita conta ligada ao banco parceiro. Vazio ou "sandbox": desenvolvimento.
BANK_ENVIRONMENT=
# "sandbox" liga a conta de teste com saldo fictício (nunca com BANK_ENVIRONMENT=production). PRX_BAAS_MODE=sandbox faz o mesmo.
# BANK_PROVIDER=sandbox
# PRX_BAAS_MODE=sandbox
# Chave (32+ caracteres) que cifra as chaves de API guardadas no banco de dados (lib/bank/secrets.ts).
BANK_ENCRYPTION_KEY=
# Segredo (HMAC) do webhook de Pix liquidado: /api/bank/webhooks/pix.
# PRX_BAAS_WEBHOOK_SECRET=
# "off" silencia as linhas de log do PRX BANK (testes).
# PRX_BANK_LOG=off

# --- Agendador (Vercel Cron) --------------------------------------------------
# Protege /api/cron/*: a Vercel envia "Authorization: Bearer <valor>". Obrigatório em produção.
CRON_SECRET=

# --- Dados da empresa (rodapé, termos e privacidade) --------------------------
# Opcionais: têm valor padrão no código (lib/company.ts).
# NEXT_PUBLIC_PRX_LEGAL_NAME=
# NEXT_PUBLIC_PRX_CNPJ=
# NEXT_PUBLIC_PRX_DPO_EMAIL=privacidade@prx.app.br
# NEXT_PUBLIC_PRIVACY_POLICY_URL=
