NEXT_PUBLIC_SUPABASE_URL=https://ltiizrewiranhyrzbwds.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

NEXT_PUBLIC_APP_URL=http://localhost:3000
# Em produção (docs/DOMINIOS.md): o app fica em teste.prx.app.br; os links entre painéis, os e-mails e os metadados partem daqui.
# NEXT_PUBLIC_SITE_URL=https://teste.prx.app.br
JWT_SECRET_OR_HMAC_KEY=your_jwt_hmac_secret
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK=true

# Notificações (docs/NOTIFICACOES.md). Sem as chaves, o desenvolvimento simula o envio.
RESEND_API_KEY=
PRX_EMAIL_FROM=PRX <noreply@prx.app.br>
PRX_EMAIL_REPLY_TO=suporte@prx.app.br
NEXT_PUBLIC_PRX_SUPPORT_EMAIL=suporte@prx.app.br
# Resenha da… (docs/RESENHA.md): opcional. Sem isso, o link sai em https://prx.app.br (em desenvolvimento, no próprio localhost).
# RESENHA_PUBLIC_URL=https://prx.app.br
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=prx_codigo_verificacao

# Asaas Banking as a Service (BaaS)
# BANK_PROVIDER=asaas liga a integração; a chave precisa ser do mesmo ambiente
# ($aact_hmlg_ = sandbox, $aact_prod_ = production). A URL aceita só hosts oficiais.
# Em .env o Next expande "$": escreva a chave como \$aact_... (na Vercel, cole sem a barra).
# Produção: ASAAS_ENVIRONMENT=production, ASAAS_API_URL=https://api.asaas.com/v3 e chave $aact_prod_.
# Com ASAAS_ENVIRONMENT=production o modo sandbox (PRX_BAAS_MODE) não liga.
ASAAS_API_KEY=your_asaas_api_key_here
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_AUTH_TOKEN=your_webhook_auth_token_32_chars_min
ASAAS_WEBHOOK_URL_EVENTS=https://prx.app.br/api/bank/webhooks/asaas
ASAAS_WEBHOOK_URL_VALIDATE_WITHDRAW=https://prx.app.br/api/bank/webhooks/validate-withdraw
ASAAS_MASTER_WALLET_ID=
BANK_PROVIDER=asaas
# Chave (32+ caracteres) que cifra as apiKeys das subcontas no banco de dados.
BANK_ENCRYPTION_KEY=

